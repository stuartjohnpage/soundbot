DISCORD_TOKEN=your-bot-token-here
ADMIN_ROLE=Soundbot Admin
SOUNDS_DIR=./sounds
# Under Docker, docker-compose.yml overrides METADATA_FILE and LOG_FILE
# to paths on the mounted volumes; these values apply to non-Docker runs.
METADATA_FILE=./sounds.json
DEFAULT_VOLUME=50
TARGET_LUFS=-16
LOG_FILE=./soundbot.log
SYNC_COMMANDS=true
# Auto-leave voice after this many seconds alone (0 = never auto-leave).
IDLE_TIMEOUT=600
# Auto-join: the bot joins these voice channels by itself when someone
# walks in. Both take a server/channel name or id; leave either blank to
# turn the feature off. Only this one server is affected.
AUTO_JOIN_GUILD=
AUTO_JOIN_CHANNELS=
# Seconds a deliberate exit (/leave, being disconnected, the channel going
# away) keeps auto-join off in that server. 0 = no mute.
AUTO_JOIN_COOLDOWN=300
# Text channel on that server to post a /board in on every auto-join, by
# name or id. Blank = no board.
AUTO_JOIN_BOARD_CHANNEL=
# Join sounds: comma-separated username:tag pairs. When that person joins
# the bot's voice channel while someone is already in it, a random sound
# with their tag plays. A user id works in place of the username. Blank = off.
JOIN_SOUNDS=
# Web admin panel: set a long random token to enable it (empty = disabled).
WEB_TOKEN=
WEB_PORT=8000
# WEB_HOST=0.0.0.0
