DISCORD_TOKEN=your-bot-token-here
ADMIN_ROLE=Soundbot Admin
SOUNDS_DIR=./sounds
# Under Docker, docker-compose.yml overrides METADATA_FILE and LOG_FILE
# to paths on the mounted volumes; these values apply to non-Docker runs.
METADATA_FILE=./sounds.json
DEFAULT_VOLUME=50
TARGET_LUFS=-16
LOG_FILE=./soundbot.log
SYNC_COMMANDS=true
# Auto-leave voice after this many seconds alone (0 = never auto-leave).
IDLE_TIMEOUT=600
# Web admin panel: set a long random token to enable it (empty = disabled).
WEB_TOKEN=
WEB_PORT=8000
# WEB_HOST=0.0.0.0
